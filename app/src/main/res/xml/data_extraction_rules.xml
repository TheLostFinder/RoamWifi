<?xml version="1.0" encoding="utf-8"?>
<!-- Saved Wi-Fi credentials are encrypted with a device-bound key and must never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
